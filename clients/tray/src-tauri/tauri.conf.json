{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sukarfleet-tray",
  "version": "0.1.0",
  "identifier": "org.sukarfleet.tray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
