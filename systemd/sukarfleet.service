# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=sukarfleet node
# The root easytier-fleet.service is a separate SYSTEM unit; a user unit
# cannot depend on it (After=/Requires= across the user/system boundary do
# not order reliably), so we only order after generic network readiness and
# let the node's own transport watchdog handle a not-yet-up mesh.
After=network.target

[Service]
Type=notify
NotifyAccess=all
# WatchdogSec MUST equal cfg.intervals.watchdogSec in the node's config.json
# (default 120, see src/config.ts). node.ts derives its WATCHDOG=1 ping
# cadence (watchdogSec/3) and its gossip/sync loop-freshness windows from
# that same config value (src/node.ts). install/setup-user.sh currently
# templates only the repo path into this unit, NOT this value -- if you
# change cfg.intervals.watchdogSec, you must also edit this line to match
# and run `systemctl --user daemon-reload`, or the two timeouts will drift
# (e.g. a widened freshness window with systemd still hard-killing at the
# old, shorter WatchdogSec).
WatchdogSec=120
# On watchdog timeout, deliver SIGTERM (not the SIGABRT default) to the bun
# main process only; KillMode=mixed sends SIGKILL to whatever children are
# still left once it exits. Neither signal produces a core dump, so apport
# stops raising "git-remote-http crashed" / "bun crashed" dialogs for what is
# really our own watchdog firing. node.ts handles SIGTERM with a graceful
# shutdown that drains its own children before exiting: it waits up to 30 s
# for in-flight git steps, then SIGTERMs them (git deletes its own lock files
# on SIGTERM), then SIGKILLs and clears the locks those leave behind -- 40 s
# at most, well inside the default TimeoutStopSec of 90 s. The drain only
# knows the children the daemon spawned itself, so KillMode=mixed's SIGKILL
# can still land on something else: an orphaned git-remote-http on a dead
# connection (lock-free), or a `git gc --auto` / maintenance run that a git
# command detached into the background, which can be holding packed-refs.lock
# or a ref lock. A lock that kill leaves is cleared by the stale-lock pass at
# the start of a later sync cycle (thresholds.staleGitLockMin). Every wait in
# the drain is bounded by a timer, so the event loop stays live and the
# handler exits even when a sync await is stuck, and systemd still escalates
# to SIGKILL after TimeoutStopSec if it somehow does not.
WatchdogSignal=SIGTERM
KillMode=mixed
WorkingDirectory=__SUKARFLEET_REPO__
# Both placeholders are substituted by install/quickstart.sh; this file is a
# template and is never installed verbatim. __SUKARFLEET_BUN__ is the resolved
# bun the installer actually found, not %h/.bun/bin/bun: the installer accepts a
# bun anywhere on PATH, so a machine with bun at /usr/local/bin/bun would
# otherwise pass preflight and get a unit that cannot start.
ExecStart=__SUKARFLEET_BUN__ run src/node.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
