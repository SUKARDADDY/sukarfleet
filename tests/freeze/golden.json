  "canonicalJson": [
    {
      "name": "key-order-ascii",
      "note": "codepoint order, uppercase before lowercase",
      "input": {
        "b": 1,
        "a": 2,
        "A": 3,
        "_": 4
      },
      "expected": "{\"A\":3,\"_\":4,\"a\":2,\"b\":1}"
    },
    {
      "name": "key-order-nested",
      "note": "sorting applies at every depth",
      "input": {
        "z": {
          "y": 1,
          "x": 2
        },
        "a": [
          3,
          1,
          2
        ]
      },
      "expected": "{\"a\":[3,1,2],\"z\":{\"x\":2,\"y\":1}}"
    },
    {
      "name": "key-order-surrogate-pair",
      "note": "THE dangerous case: codepointCompare uses Array.from (code points). A naive charCodeAt implementation compares UTF-16 units and orders U+1F600 (surrogate D83D) BEFORE U+FFFD, which is the opposite of code-point order. Any reimplementation that gets this wrong produces different signing bytes for any object with an astral-plane key.",
      "input": {
        "😀": "emoji",
        "�": "replacement",
        "a": "ascii"
      },
      "expected": "{\"a\":\"ascii\",\"�\":\"replacement\",\"😀\":\"emoji\"}"
    },
    {
      "name": "key-order-latin1",
      "note": "e-acute (U+00E9) sorts after z (U+007A)",
      "input": {
        "é": 1,
        "z": 2
      },
      "expected": "{\"z\":2,\"é\":1}"
    },
    {
      "name": "undefined-dropped",
      "note": "object properties with undefined are omitted",
      "input": {
        "a": 1,
        "c": 3
      },
      "expected": "{\"a\":1,\"c\":3}"
    },
    {
      "name": "undefined-in-array",
      "note": "array elements that are undefined encode as null",
      "input": [
        1,
        null,
        3
      ],
      "expected": "[1,null,3]"
    },
    {
      "name": "null-preserved",
      "note": "null is a value, not an omission",
      "input": {
        "a": null
      },
      "expected": "{\"a\":null}"
    },
    {
      "name": "arrays-keep-order",
      "note": "arrays are NOT sorted",
      "input": [
        "c",
        "a",
        "b"
      ],
      "expected": "[\"c\",\"a\",\"b\"]"
    },
    {
      "name": "empty-containers",
      "note": "",
      "input": {
        "o": {},
        "a": []
      },
      "expected": "{\"a\":[],\"o\":{}}"
    },
    {
      "name": "numbers",
      "note": "integers, negatives, floats, exponents",
      "input": {
        "i": 42,
        "n": -7,
        "f": 1.5,
        "e": 1e+21,
        "z": 0
      },
      "expected": "{\"e\":1e+21,\"f\":1.5,\"i\":42,\"n\":-7,\"z\":0}"
    },
    {
      "name": "negative-zero",
      "note": "JSON.stringify(-0) is \"0\"",
      "input": {
        "z": 0
      },
      "expected": "{\"z\":0}"
    },
    {
      "name": "string-escapes",
      "note": "quotes, backslash, newline, tab, control chars",
      "input": {
        "s": "a\"b\\c\nd\te\u0001f"
      },
      "expected": "{\"s\":\"a\\\"b\\\\c\\nd\\te\\u0001f\"}"
    },
    {
      "name": "unicode-values",
      "note": "non-ASCII values are not escaped by JSON.stringify",
      "input": {
        "s": "héllo 😀"
      },
      "expected": "{\"s\":\"héllo 😀\"}"
    },
    {
      "name": "booleans",
      "note": "",
      "input": {
        "t": true,
        "f": false
      },
      "expected": "{\"f\":false,\"t\":true}"
    },
    {
      "name": "deep-nesting",
      "note": "",
      "input": {
        "a": {
          "b": {
            "c": {
              "d": [
                1,
                {
                  "e": 2
                }
              ]
            }
          }
        }
      },
      "expected": "{\"a\":{\"b\":{\"c\":{\"d\":[1,{\"e\":2}]}}}}"
    },
    {
      "name": "reject-nan",
      "note": "non-finite numbers are rejected, never encoded",
      "input": {
